# Minimal Circlus server configuration.
#
# Use this for the first manual/server-only launch:
#   cp .env.minimal.example .env
#   edit .env
#
# Advanced TTLs, limits, attachment storage paths, and rate-limit tuning are
# documented in .env.example.

# Required: PostgreSQL connection used by the server and migration scripts.
# For a manual/server-only launch, insert the generated password into this URL.
# Example: postgresql://fm_user:<generated-hex-password>@localhost:5432/family_messenger
DATABASE_URL=
# Used by server/docker-compose.yml for the bundled PostgreSQL container.
# Generate once, for example: openssl rand -hex 32
# Docker Compose refuses to start while this value is empty.
POSTGRES_PASSWORD=

# Required: unique stable identifier for this physical server/VPS.
# Any short stable value is fine, for example: home-vps-1, prod-eu-1.
VPS_ID=home-vps-1

# Recommended for production.
NODE_ENV=production
PORT=3000

# Recommended behind Nginx/Caddy/Apache on the same host.
# Trust exactly one reverse-proxy hop for req.ip / rate limiting.
TRUST_PROXY=1

# Optional additional trusted web clients. https://web.circlus.org is trusted
# by default; add custom client origins only when this server should allow them.
TRUSTED_CLIENT_ORIGINS=

# Advanced proxy/client-origin options are documented in .env.example.
# Most Circlus servers should preserve the original Host header in the reverse proxy
# and do not need TENANCY_TRUST_FORWARDED_HOST here.

# Push relay / mobile push central integration.
# Request managed services access from Circlus or provide your own compatible
# push service. Leave credentials empty while access is pending.
PUSH_SERVICE_URL=
ENABLE_RELAY_DELIVERY=false
PUSH_SERVICE_CLIENT_ID=
PUSH_SERVICE_KEY_ID=k1
# Base64-encoded 32+ random bytes; required whenever PUSH_SERVICE_URL is set.
PUSH_SERVICE_SHARED_SECRET=
# Encrypts push credentials installed through Server Management. Generate once
# with `openssl rand -base64 32`; Docker Compose uses the generated file instead.
MANAGED_PUSH_CONFIG_ENCRYPTION_KEY=
MANAGED_PUSH_CONFIG_ENCRYPTION_KEY_FILE=
# At least 32 bytes; required before native/mobile call actions are used.
MOBILE_CALL_ACTION_SECRET=

# ICE/TURN configuration service.
# The Circlus server does not store coturn secrets. It authenticates to a
# separate ICE config service, which selects the assigned TURN cluster and
# returns short-lived WebRTC iceServers.
# Request managed TURN access from Circlus or provide your own compatible ICE
# config service. Leave these empty while access is pending; calls may still
# work peer-to-peer, but TURN will be unavailable on restrictive networks.
ICE_CONFIG_SERVICE_URL=
# ICE auth server id defaults to VPS_ID. Set ICE_CONFIG_SERVER_ID only if you need a separate ICE identity.
ICE_CONFIG_KEY_ID=k1
# Base64-encoded 32+ random bytes; required whenever ICE_CONFIG_SERVICE_URL is set.
# Must match the per-server secret approved in the ICE config service.
ICE_CONFIG_SHARED_SECRET=
# Docker/secret-file alternative. Do not configure both values.
ICE_CONFIG_SHARED_SECRET_FILE=
# Stable base64-encoded 32+ random bytes for opaque Circle/call accounting ids.
# Keep unchanged during S2S secret rotation; defaults to ICE_CONFIG_SHARED_SECRET.
ICE_SUBJECT_ID_SECRET=
# Docker/secret-file alternative. Do not configure both values.
ICE_SUBJECT_ID_SECRET_FILE=

# Optional diagnostics. Keep disabled in normal production because these logs may
# include stable identity/device/call identifiers and ICE candidate addresses.
CALL_SIGNALING_DIAGNOSTICS=false
CALL_ICE_DIAGNOSTICS=false

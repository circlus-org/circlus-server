# Full Circlus server environment reference.
#
# For first-time setup, start from .env.minimal.example instead:
#   cp .env.minimal.example .env
#
# This file documents optional tuning knobs and feature-specific settings.
#
# Status tags:
#
# - Required: set explicitly in real .env for your deployment.
# - Optional (code default): app has fallback in code if key is missing.
# - Conditionally required: required only when related feature is enabled.

# Database Configuration
# [Conditionally required] Required when NODE_ENV=production; local development has a localhost fallback.
DATABASE_URL=postgresql://fm_user:your-secure-password@localhost:5432/family_messenger

# [Optional, tests only] PostgreSQL URL for reaction integration tests. Leave empty to skip them.
REACTION_TEST_DATABASE_URL=

# Server Configuration
# [Optional (code default)] HTTP port.
PORT=3000
# [Optional (code default)] Runtime mode: development, test, or production.
# Production requires an explicit DATABASE_URL and rejects malformed critical settings at startup.
NODE_ENV=development

# [Optional (code default)] Minimum structured log level: debug, info, warn, error, or silent.
# Defaults to info (silent during tests).
LOG_LEVEL=info
# [Optional (code default)] Log encoding: json or pretty. Production defaults to json.
LOG_FORMAT=pretty

# [Optional (code default)] Explicit env file path for runtime loader.
ENV_FILE=.env

# Reverse proxy (Nginx/Caddy/Traefik)
# Controls Express "trust proxy" setting (affects req.ip, req.protocol, etc.)
# Recommended behind Nginx on the same host: TRUST_PROXY=1
# Backwards compatible: TRUST_PROXY=true => behaves like 1 (trust only the direct proxy hop)
# Other valid values: loopback | linklocal | uniquelocal | <subnet> | <ip>
# IMPORTANT (security): in Nginx, overwrite X-Forwarded-For to $remote_addr (not $proxy_add_x_forwarded_for)
# to prevent client spoofing of IP-based rate limiting.
# [Optional (code default)] Express trust proxy setting.
TRUST_PROXY=false

# [Required] Unique identifier for this physical server/VPS instance.
# Used to attribute system events (e.g. missed calls) to the correct server.
# Example: vps-01, prod-eu-1
VPS_ID=
# Optional managed wildcard suffix. When set, tenant creation can omit publicBaseUrl.
# The generated address is https://<tenant-id>.<suffix> and requires wildcard DNS/TLS.
CIRCLE_WILDCARD_BASE_DOMAIN=

# For Multi-Tenancy:
# Tenant is derived from request host (supports ANY domain).
# The tenant key is the normalized host (lowercase, port stripped).
# If true, tenancy middleware may trust X-Forwarded-Host from trusted proxy.
# [Optional (code default)] Trust X-Forwarded-Host for tenancy resolution.
TENANCY_TRUST_FORWARDED_HOST=false

# WebSocket transport
# [Optional (code default)] WS endpoint path.
WS_PATH=/ws
# [Optional (code default)] Server heartbeat interval for WS clients.
WS_HEARTBEAT_INTERVAL_MS=30000
# [Optional (code default)] Hard transport limit for one WebSocket message (1 MiB).
WS_MAX_PAYLOAD_BYTES=1048576
# Bounded WS resources; counts include work currently being processed.
WS_MAX_UNREGISTERED_CONNECTIONS=64
WS_SOFT_MAX_CONNECTIONS=192
WS_MAX_CONNECTIONS=256
WS_MAX_CONNECTIONS_PER_IP=128
WS_HANDSHAKE_TIMEOUT_MS=10000
WS_REGISTRATION_TIMEOUT_MS=30000
WS_MAX_QUEUED_MESSAGES=128
WS_MAX_QUEUED_BYTES=4194304
WS_MAX_UNREGISTERED_MESSAGES=8
WS_MAX_UNREGISTERED_BYTES=262144
WS_MAX_GLOBAL_QUEUED_MESSAGES=4096
WS_MAX_GLOBAL_QUEUED_BYTES=33554432
WS_MAX_OUTGOING_BYTES=8388608
WS_MAX_OUTGOING_MESSAGES=256
WS_MAX_GLOBAL_OUTGOING_MESSAGES=8192
WS_MAX_GLOBAL_OUTGOING_BYTES=67108864
# [Optional (code default)] Time to drain HTTP, WebSocket, and background work on SIGTERM/SIGINT.
SHUTDOWN_GRACE_PERIOD_MS=30000

# ICE/TURN configuration service.
# The Circlus server does not keep coturn secrets locally. It authenticates to
# a separate ICE config service, which selects the assigned TURN cluster and
# returns short-lived WebRTC iceServers.
# [Required for TURN] Base URL of a compatible ICE config service, e.g. https://ice.example.com.
# Leave empty while managed TURN access is pending.
ICE_CONFIG_SERVICE_URL=
# [Optional (code default)] ICE auth server id. Defaults to VPS_ID; set only if this server needs a separate ICE identity.
ICE_CONFIG_SERVER_ID=
# [Required] Key id for S2S secret rotation.
ICE_CONFIG_KEY_ID=k1
# [Required when ICE_CONFIG_SERVICE_URL is set] Base64 shared secret encoding at least 32 random bytes.
ICE_CONFIG_SHARED_SECRET=
# Docker/secret-file alternative. Do not configure both values.
ICE_CONFIG_SHARED_SECRET_FILE=
# [Recommended] Stable 32+ byte base64 secret for opaque Circle/call accounting ids.
# Keep it unchanged when rotating ICE_CONFIG_SHARED_SECRET so metric history remains continuous.
# Falls back to ICE_CONFIG_SHARED_SECRET when omitted.
ICE_SUBJECT_ID_SECRET=
# Docker/secret-file alternative. Do not configure both values.
ICE_SUBJECT_ID_SECRET_FILE=
# [Optional (code default)] Request timeout for ICE config service calls.
ICE_CONFIG_TIMEOUT_MS=3000

# [Optional] Comma-separated list of additional globally trusted client origins
# for device enrollment and API CORS access. https://web.circlus.org is always
# trusted and cannot be removed here; add only custom web clients operated or
# trusted by this server.
TRUSTED_CLIENT_ORIGINS=
# [Optional] Allow local/insecure HTTP mode. Defaults to true unless NODE_ENV=production.
# Keep empty in production; set true only for local HTTP or temporary non-TLS testing.
SECURITY_ALLOW_INSECURE_HTTP=
# [Optional (code default)] Disable profile names storage on server side.
NO_NAMES_ON_SERVER=false

# Push-service (public) integration
# Circlus server delegates both:
# - Web Push Relay (`/api/push/*`)
# - Mobile central delivery (`/api/mobile/deliver`)
#
# [Required for managed push] Base URL of the push-service (no trailing slash), e.g. https://push.example.com.
# Leave empty while managed services access is pending.
PUSH_SERVICE_URL=
#
# [Required for managed push] Enable relay delivery after push credentials are approved.
ENABLE_RELAY_DELIVERY=false

# Server-to-server auth (Circlus server -> push-service) using HMAC.
# Required for both Web Push Relay and Mobile central delivery. Mobile delivery
# additionally sends its endpoint-scoped bearer delivery token.
# [Required for managed push] Stable identifier of this Circlus server instance (example: srv_<serverId>).
PUSH_SERVICE_CLIENT_ID=
# [Required] Key identifier for rotation (example: k1).
PUSH_SERVICE_KEY_ID=k1
# [Required when PUSH_SERVICE_URL is set] Shared secret for HMAC, base64-encoded 32+ random bytes.
PUSH_SERVICE_SHARED_SECRET=
# Base64-encoded 32-byte key used only to encrypt managed push credentials in
# PostgreSQL. Configure either the inline value or the file. Keep it stable.
MANAGED_PUSH_CONFIG_ENCRYPTION_KEY=
MANAGED_PUSH_CONFIG_ENCRYPTION_KEY_FILE=

# Advanced tuning below this line. Most deployments can keep these unset and use
# code defaults. Copy only the values you intentionally want to change.

# HTTP request body limits
# [Optional (code default)] Max JSON body accepted by regular API endpoints.
API_JSON_LIMIT=1mb
# [Optional (code default)] Max JSON body accepted by message archive endpoints.
MESSAGE_ARCHIVE_JSON_LIMIT=2mb
# [Optional (code default)] Max JSON body accepted by encrypted vault endpoints.
VAULT_JSON_LIMIT=8mb
# [Optional (code default)] Log JSON requests with Content-Length at/above this many bytes.
LARGE_JSON_REQUEST_LOG_THRESHOLD_BYTES=102400

# Security windows and token TTLs
# [Optional (code default)] Nonce validity window.
NONCE_WINDOW_MS=300000
# [Optional (code default)] Max allowed clock drift.
MAX_TIMESTAMP_DRIFT_MS=60000
# [Optional (code default)] Mobile bind token lifetime.
MOBILE_BIND_TOKEN_TTL_SEC=120
# [Required for native/mobile call actions] Mobile decline/action token secret, at least 32 bytes.
MOBILE_CALL_ACTION_SECRET=

# Call behavior / WS payload limits
# [Optional (code default)] Max message payload size.
MAX_MESSAGE_BYTES=16384
# [Optional (code default)] Max sync messages per batch.
MAX_SYNC_BATCH=100
# [Optional (code default)] Max call history rows per sync batch.
MAX_CALL_HISTORY_SYNC_BATCH=200
# [Optional (code default)] Max system events per sync batch.
MAX_SYSTEM_SYNC_BATCH=200
# [Optional (code default)] WS rate limiter threshold.
MAX_WS_RATE=50
# [Optional (code default)] WS call signaling rate limiter threshold.
MAX_WS_CALL_RATE=200
# [Optional (code default)] WS call-end rate limiter threshold.
MAX_WS_CALL_END_RATE=300
# [Optional (code default)] Incoming call timeout.
CALL_RING_TIMEOUT_MS=65000
# [Optional (code default)] Caller hangup stays "cancelled" for this long after confirmed delivery.
CALL_CANCEL_DELIVERED_GRACE_MS=3000
# [Optional (code default)] Without delivery evidence, caller hangup becomes "no answer" after this long.
CALL_CANCEL_NO_DELIVERY_FALLBACK_MS=10000
# [Optional (code default)] Retry interval for push during ringing.
CALL_PUSH_REPEAT_INTERVAL_MS=5000
# [Optional (code default)] Total pushes including the initial one; 1 disables repeats.
CALL_PUSH_REPEAT_MAX_ATTEMPTS=1
# [Optional (code default)] Call link TTL in hours.
CALL_LINK_TTL_HOURS=72

# Diagnostics. Disabled by default because these logs may include stable
# identity/device/call identifiers and ICE candidate addresses.
CALL_SIGNALING_DIAGNOSTICS=false
CALL_ICE_DIAGNOSTICS=false

# Device enrollment
# [Optional (code default)] Enrollment request TTL in milliseconds.
DEVICE_ENROLLMENT_TTL_MS=600000
# [Optional (code default)] Approved enrollment payload lifetime in milliseconds.
DEVICE_ENROLLMENT_PAYLOAD_TTL_MS=600000

# Presence and HTTP fallback signaling
PRESENCE_ONLINE_WINDOW_SECONDS=75
PRESENCE_WS_TOUCH_INTERVAL_MS=30000
HTTP_CALL_SIGNALING_SESSION_TTL_MS=900000
HTTP_CALL_SIGNALING_MAX_POLL_MS=10000
HTTP_CALL_SIGNALING_MAX_QUEUE=500
HTTP_SIGNALING_MAX_SESSIONS=512
HTTP_SIGNALING_MAX_SESSIONS_PER_IP=128
HTTP_SIGNALING_MAX_QUEUE_BYTES=4194304
HTTP_SIGNALING_MAX_GLOBAL_BYTES=33554432

# Group chats
# [Optional (code default)] Max group title length.
GROUP_CHAT_TITLE_MAX_LEN=120
# [Optional (code default)] Max participants when creating a group.
GROUP_CHAT_CREATE_PARTICIPANTS_MAX=64
# [Optional (code default)] Max participants added in a single request.
GROUP_CHAT_ADD_BATCH_MAX=32
# [Optional (code default)] Max encrypted group message payload size in bytes.
GROUP_CHAT_MESSAGE_MAX_BYTES=16384
# [Optional (code default)] Max messages returned by group message listing.
GROUP_CHAT_MESSAGES_LIST_MAX_LIMIT=500

# Temporary access / contact requests
# [Optional (code default)] Temporary trusted access request TTL in milliseconds.
TEMPORARY_TRUSTED_ACCESS_REQUEST_TTL_MS=600000
TEMPORARY_RENEWAL_REQUEST_TTL_MS=600000

# Data retention / cleanup
# [Optional (code default)] Message retention (hours).
MESSAGE_TTL_HOURS=24
# [Optional (code default)] Call history retention (hours).
CALL_HISTORY_TTL_HOURS=72
# [Optional (code default)] Connected call heartbeat timeout.
CALL_HISTORY_HEARTBEAT_TIMEOUT_MS=45000
# [Optional (code default)] Connected call heartbeat sweep interval.
CALL_HISTORY_HEARTBEAT_SWEEP_MS=60000
# [Optional (code default)] Root directory for encrypted attachment blobs.
ATTACHMENTS_STORAGE_DIR=
# [Optional (code default)] Temporary upload directory for encrypted attachments.
ATTACHMENTS_TMP_DIR=
# [Optional (code default)] Upload reservation TTL in milliseconds.
ATTACHMENTS_RESERVATION_TTL_MS=900000
# [Optional (code default)] Minimal free disk bytes kept after attachment admission.
ATTACHMENTS_MIN_FREE_DISK_BYTES=268435456
# [Optional (code default)] Max raw HTTP body accepted by upload endpoint.
ATTACHMENTS_MAX_HTTP_BODY=250mb
# [Optional (code default)] Max attachment/public-asset upload streams handled concurrently by one server process.
ATTACHMENTS_MAX_CONCURRENT_UPLOADS=2
# [Optional (code default)] System event retention (hours).
SYSTEM_EVENT_TTL_HOURS=168
# [Optional (code default)] Expired invites cleanup interval (hours).
INVITE_CLEANUP_INTERVAL_HOURS=24
# [Optional (code default)] Root directory for generated Public Circle Site static files.
PUBLIC_SITE_STORAGE_DIR=
# [Optional (code default)] Public-site publication asset and temporary directories.
PUBLIC_SITE_ASSETS_DIR=
PUBLIC_SITE_ASSETS_TMP_DIR=
PUBLIC_SITE_ASSET_READY_TTL_HOURS=24
# [Optional (code default)] Public Circlus product URL shown in generated site pages.
CIRCLUS_PUBLIC_SITE_URL=https://circlus.org
# [Optional (code default)] Web client deep-link base used by inspector links.
CIRCLUS_APP_OPEN_URL=https://web.circlus.org/open
# [Optional (code default)] Comma-separated Circlus-managed domain suffixes where public-site
# publishing is blocked (e.g. user-provisioned space.circlus.org subdomains).
CIRCLUS_PUBLIC_SITE_BLOCKED_DOMAIN_SUFFIXES=space.circlus.org

# Experimental Android Restore Credential enrollment. Keep false until the
# two-device physical release gate in PLATFORM_RECOVERY_ENROLLMENT.md passes.
PLATFORM_RECOVERY_ENABLED=false

# Rate limiting (in-memory; per-process)
# Global limiter applied to all /api (key: IP)
# [Optional (code default)] Global rate-limit window.
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# [Optional (code default)] Global rate-limit max requests.
RATE_LIMIT_GLOBAL_MAX=600

# Pre-tenancy Circle migration endpoints (key: IP).
RATE_LIMIT_MIGRATION_VERIFY_WINDOW_MS=60000
RATE_LIMIT_MIGRATION_VERIFY_MAX=10
RATE_LIMIT_MIGRATION_SESSION_WINDOW_MS=60000
RATE_LIMIT_MIGRATION_SESSION_MAX=120
# 32 random bytes encoded as base64. Required on every server that creates or
# runs Circle migrations; protects recovery/idempotency credentials at rest.
CIRCLE_MIGRATION_SECRET_KEY_BASE64=
# Optional local package directory. Defaults to server-data/circle-migrations.
CIRCLE_MIGRATION_EXPORT_DIR=
CIRCLE_MIGRATION_IMPORT_DIR=
CIRCLE_MIGRATION_FREEZE_DRAIN_TIMEOUT_MS=60000
CIRCLE_MIGRATION_HTTP_TIMEOUT_MS=10000
# [Optional, migration CLI only] Override the migrations directory.
MIGRATIONS_DIR=

# Auth endpoints (check-invite/register/recovery) (key: IP + family)
# [Optional (code default)] Auth limiter window.
RATE_LIMIT_AUTH_WINDOW_MS=60000
# [Optional (code default)] checkInvite limit.
RATE_LIMIT_AUTH_CHECK_INVITE_MAX=30
# [Optional (code default)] register limit.
RATE_LIMIT_AUTH_REGISTER_MAX=10
# [Optional (code default)] register-device limit.
RATE_LIMIT_AUTH_REGISTER_DEVICE_MAX=20
# [Optional (code default)] identity-encrypted-key limit.
RATE_LIMIT_AUTH_IDENTITY_ENCRYPTED_KEY_MAX=30
# [Optional (code default)] identity lookup limit.
RATE_LIMIT_AUTH_IDENTITY_LOOKUP_MAX=60

# Config endpoints (ice-servers/server-name/turn-credentials) (key: IP + family)
# [Optional (code default)] Config limiter window.
RATE_LIMIT_CONFIG_WINDOW_MS=60000
# [Optional (code default)] ice-servers endpoint limit.
RATE_LIMIT_CONFIG_ICE_SERVERS_MAX=120
# [Optional (code default)] turn-credentials endpoint limit.
RATE_LIMIT_CONFIG_TURN_CREDENTIALS_MAX=60
# [Optional (code default)] server-name endpoint limit.
RATE_LIMIT_CONFIG_SERVER_NAME_MAX=120
# [Optional (code default)] capabilities endpoint limit.
RATE_LIMIT_CONFIG_CAPABILITIES_MAX=120

# Host provisioning endpoints (pre-tenancy, key: IP)
RATE_LIMIT_HOST_PROVISIONING_WINDOW_MS=60000
RATE_LIMIT_HOST_PROVISIONING_MAX=10

# Push endpoints (key: IP + family)
# [Optional (code default)] Push limiter window.
RATE_LIMIT_PUSH_WINDOW_MS=60000
# [Optional (code default)] VAPID key endpoint limit.
RATE_LIMIT_PUSH_VAPID_KEY_MAX=120
# [Optional (code default)] Push mutations endpoint limit.
RATE_LIMIT_PUSH_MUTATIONS_MAX=120

# Identities endpoints (key: IP + family)
# [Optional (code default)] Identities limiter window.
RATE_LIMIT_IDENTITIES_WINDOW_MS=60000
# [Optional (code default)] Published identities endpoint limit.
RATE_LIMIT_IDENTITIES_PUBLISHED_MAX=60
# [Optional (code default)] Avatar upload limit.
RATE_LIMIT_IDENTITIES_AVATAR_UPLOAD_MAX=10

# Device enrollments (key: IP + family)
# [Optional (code default)] Device enrollment limiter window.
RATE_LIMIT_DEVICE_ENROLLMENTS_WINDOW_MS=60000
# [Optional (code default)] Create enrollment limit.
RATE_LIMIT_DEVICE_ENROLLMENTS_CREATE_MAX=20
# [Optional (code default)] Read payload / approval limit.
RATE_LIMIT_DEVICE_ENROLLMENTS_PAYLOAD_MAX=60

# Group chats (key: IP + family)
# [Optional (code default)] Group chat limiter window.
RATE_LIMIT_GROUP_CHATS_WINDOW_MS=60000
# [Optional (code default)] Group chat mutations/list requests limit.
RATE_LIMIT_GROUP_CHATS_MAX=240

# Messages endpoints (key: IP + family)
# [Optional (code default)] Messages limiter window.
RATE_LIMIT_MESSAGES_WINDOW_MS=60000
# [Optional (code default)] Messages requests limit.
RATE_LIMIT_MESSAGES_MAX=240

# Authenticated HTTP requests across direct/group chats and channels, per circle identity.
# All devices and roles share these budgets. Reads and mutations are independent.
# Read/received acknowledgments count as mutations. Existing IP limits still apply.
# Counters are per server process and reset on restart, like the existing IP limiter.
RATE_LIMIT_COMMUNICATION_IDENTITY_WINDOW_MS=60000
RATE_LIMIT_COMMUNICATION_IDENTITY_READ_MAX=600
RATE_LIMIT_COMMUNICATION_IDENTITY_WRITE_MAX=240

# Public link resolution (key: IP)
RATE_LIMIT_LINK_RESOLVE_WINDOW_MS=60000
RATE_LIMIT_LINK_RESOLVE_MAX=60

# Group chat invite links (key: IP + family)
# [Optional (code default)] Invite-link limiter window.
RATE_LIMIT_GROUP_CHAT_INVITE_LINKS_WINDOW_MS=60000
# [Optional (code default)] Invite-link requests limit.
RATE_LIMIT_GROUP_CHAT_INVITE_LINKS_MAX=60

# Temporary access (key: IP + family)
# [Optional (code default)] Temporary access limiter window.
RATE_LIMIT_TEMPORARY_ACCESS_WINDOW_MS=60000
# [Optional (code default)] Temporary contact/trusted request create limit.
RATE_LIMIT_TEMPORARY_CONTACT_CREATE_MAX=20

# Server-admin domain verification. Disable only in isolated development.
SERVER_ADMIN_TENANT_DNS_CHECK=true
SERVER_ADMIN_TENANT_TLS_CHECK=true
# Timeout for the outbound TLS certificate probe during tenant provisioning.
SERVER_ADMIN_TENANT_TLS_TIMEOUT_MS=5000

# TIP: Use ./init-db.sh to apply schema/migrations and generate SQL types.

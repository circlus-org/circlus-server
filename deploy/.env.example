# Copy to deploy/.env and run commands with:
# docker compose --env-file deploy/.env ...

VPS_ID=home-vps-1
POSTGRES_PASSWORD=
PORT=3000

# Public hostname or IP clients use to reach the local coturn instance.
TURN_PUBLIC_HOST=turn.example.com
TURN_REALM=turn.example.com
# Set when the VPS is behind 1:1 NAT. Leave empty when the public address is
# assigned directly to a host interface.
TURN_EXTERNAL_IP=
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200

# Normal Circlus Server settings used by the full-stack public deployment.
NODE_ENV=production
TRUST_PROXY=1
TRUSTED_CLIENT_ORIGINS=
ENABLE_RELAY_DELIVERY=false
PUSH_SERVICE_URL=
PUSH_SERVICE_CLIENT_ID=
PUSH_SERVICE_KEY_ID=k1
PUSH_SERVICE_SHARED_SECRET=
MOBILE_CALL_ACTION_SECRET=
ICE_CONFIG_KEY_ID=k1
ICE_CONFIG_TIMEOUT_MS=3000
CALL_SIGNALING_DIAGNOSTICS=false
CALL_ICE_DIAGNOSTICS=false

# Optional WebSocket capacity overrides (all have bounded code defaults).
# See docs/WEBSOCKET_LIMITS.md for every setting and memory-budget scope.
# WS_MAX_CONNECTIONS=256
# WS_MAX_CONNECTIONS_PER_IP=128
# WS_REGISTRATION_TIMEOUT_MS=30000

{
  "schemaVersion": 1,
  "defaultTtlSeconds": 3600,
  "stunUrls": [
    "stun:stun.l.google.com:19302",
    "stun:stun1.l.google.com:19302"
  ],
  "turnClusters": [
    {
      "id": "local",
      "displayName": "Local TURN",
      "status": "active",
      "ownership": "local",
      "location": "Current VPS",
      "urls": [
        "turn:TURN_PUBLIC_HOST:TURN_LISTEN_PORT?transport=udp",
        "turn:TURN_PUBLIC_HOST:TURN_LISTEN_PORT?transport=tcp"
      ],
      "auth": {
        "mode": "turn-rest-secret",
        "secretFile": "/run/circlus-secrets/turn-local.secret",
        "ttlSeconds": 3600
      }
    }
  ],
  "authorizedServers": [
    {
      "serverId": "VPS_ID",
      "keyId": "ICE_CONFIG_KEY_ID",
      "status": "active",
      "s2sSharedSecretFile": "/run/circlus-secrets/ice-s2s.secret",
      "defaultTurnClusterId": "local",
      "allowedTurnClusterIds": [
        "local"
      ]
    }
  ]
}
